NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comunidades: deixe vazio até cadastrar links reais
NEXT_PUBLIC_WHATSAPP_GROUP_URL=
NEXT_PUBLIC_TELEGRAM_GROUP_URL=

# Bot administrativo do Telegram (somente no servidor)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# IDs numericos autorizados, separados por virgula. Ex.: 123456789,987654321
TELEGRAM_ADMIN_USER_IDS=
